        <mxCell id="title" value="WHEN THE PRODUCER IS FASTER THAN THE CONSUMER" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1">
