          <mxGeometry x="475" y="413" width="250" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="queue-copy" value="Absorb the temporary burst.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Protects events, but capacity and consumer lag must be managed.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#71400A;" vertex="1" parent="1">
