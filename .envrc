# direnv: entering this directory gives you the pinned Go toolchain and the .env
# credentials, so `go`, `golangci-lint` and `make` all resolve to the same versions
# CI uses. Run `direnv allow` once after cloning.

# Pinned toolchain from devbox.json. Requires devbox >= 0.17.
eval "$(devbox generate direnv --print-envrc)"

# ClickHouse credentials. .env is gitignored — copy .env.example and fill it in.
# dotenv_if_exists, not dotenv: a fresh clone has no .env and must still get a shell.
dotenv_if_exists .env

# Locally built binaries (make build -> ./bin) run without ./bin prefixes.
PATH_add bin
