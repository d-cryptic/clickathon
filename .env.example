# Copy to .env and fill in. .env is gitignored — never commit it.

# --- ClickHouse Cloud (the graded target; provisioned at the venue) ---
CH_HOST=your-service.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=
CH_SECURE=true
CH_DATABASE=sonyliv

# --- local ClickHouse for fast iteration (docker compose up) ---
CH_LOCAL_URL=http://localhost:8123
CH_PASSWORD_LOCAL=changeme
# REQUIRED (ADR 0018): the database local work targets. The local container's
# data lives in `default`. CH_DATABASE above names the GRADED Cloud database and
# is never read by the local target: Go and tools/ch fail loudly if this is
# unset rather than borrowing it, and apply-sql.sh/load.sh prefer it over
# CH_DATABASE when both are set.
CH_DATABASE_LOCAL=default
# REQUIRED: passed into the container so sql/05_users.sh can create the agent user.
# A .env alone does NOT reach the container — it must also be listed under `environment:`.
AGENT_PASSWORD=changeme-agent

# --- ClickStack (the OSS integration) ---
CS_EMAIL=team@clickathon.local
CS_PASSWORD=
CLICKSTACK_OTLP=http://localhost:4318

# --- ClickStack / HyperDX built into ClickHouse Cloud ---
# Control-plane API key (console -> Settings -> API Keys). Drives tools/clickstack-cloud.sh.
CH_API_KEY_ID=
CH_API_KEY_SECRET=
# The HyperDX connection id. The REST API only ever returns connections nested
# inside sources, so on a service with ZERO sources it cannot be discovered —
# get it from the clickstack MCP (clickstack_list_sources returns `connections`)
# or the console URL, once, and paste it here.
CLICKSTACK_CONNECTION_ID=
